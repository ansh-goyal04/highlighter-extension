{
  "manifest_version": 3,
  "name": "MVP Highlighter",
  "version": "1.0",
  "description": "Highlight and save text on any page.",
  "permissions": ["storage","contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}